{
  "name": "toka-sdk",
  "version": "1.4.0",
  "description": "TypeScript cost-control, smart model routing, and observability architecture for LLM and AI code agents.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "toka": "./bin/toka"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "MIGRATION.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "LICENSE",
    "assets"
  ],
  "scripts": {
    "dev": "ts-node src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts tests/**/*.ts",
    "format:check": "prettier --check src/**/*.ts tests/**/*.ts",
    "typecheck": "tsc --noEmit",
    "smoke": "npm run build && node -e \"const { Toka, MockProvider, OpenAIProvider, AnthropicProvider, GeminiProvider, MultiProvider, ModelRouter, CostReporter, AgentAnalytics, TokaPricingError } = require('./dist'); if (!Toka || !MockProvider || !OpenAIProvider || !AnthropicProvider || !GeminiProvider || !MultiProvider || !ModelRouter || !CostReporter || !AgentAnalytics || !TokaPricingError) process.exit(1); console.log('package import ok')\"",
    "check": "npm run typecheck && npm run test:coverage && npm run smoke",
    "prepare": "npm run build"
  },
  "keywords": [
    "llm",
    "ai",
    "cost-control",
    "llm-cost",
    "budget-management",
    "ai-agents",
    "coding-agents",
    "agentic-ai",
    "smart-routing",
    "model-routing",
    "ai-gateway",
    "llm-gateway",
    "observability",
    "opentelemetry",
    "tracing",
    "finops",
    "token-counter",
    "openai",
    "anthropic",
    "claude",
    "gemini",
    "deepseek",
    "redis-cache",
    "semantic-cache",
    "fallback",
    "rate-limiting",
    "typescript",
    "developer-tools"
  ],
  "author": "Abreham Wondimu Shiferaw",
  "license": "MIT",
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/abrehamshiferaw"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abrehamshiferaw/toka.git"
  },
  "bugs": {
    "url": "https://github.com/abrehamshiferaw/toka/issues"
  },
  "homepage": "https://github.com/abrehamshiferaw/toka#readme",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^25.3.0",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "eslint": "^10.11.0",
    "jest": "^30.2.0",
    "prettier": "^3.8.1",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
