{
  "name": "toka-sdk",
  "version": "1.3.0",
  "description": "TypeScript cost-control and observability architecture for LLM applications.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "require": "./dist/index.js" } },
  "files": ["dist", "README.md", "LICENSE", "assets"],
  "scripts": {
    "build": "tsc",
    "start": "ts-node src/index.ts",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts tests/**/*.ts",
    "format:check": "prettier --check src/**/*.ts tests/**/*.ts",
    "typecheck": "tsc --noEmit",
    "smoke": "npm run build && node -e \"const { Toka, MockProvider } = require('./dist'); if (!Toka || !MockProvider) process.exit(1); console.log('package import ok')\"",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test:coverage && npm run smoke",
    "prepare": "npm run build"
  },
  "keywords": ["AI", "SDK", "Open Source", "Cost Control", "Developer Tools"],
  "author": "Abreham Wondimu Shiferaw",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/abrehamshiferaw/toka.git" },
  "bugs": { "url": "https://github.com/abrehamshiferaw/toka/issues" },
  "homepage": "https://github.com/abrehamshiferaw/toka#readme",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^25.3.0",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "eslint": "^10.0.0",
    "jest": "^30.2.0",
    "prettier": "^3.8.1",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
