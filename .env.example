# AI Provider Keys (Production)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# Toka Configuration
TOKA_ROUTING=balanced
TOKA_MODELS=gpt-4o,gpt-4o-mini,claude-3-5-sonnet,claude-3-5-haiku,gemini-2.5-flash,deepseek-chat
TOKA_MAX_COST=1.0
TOKA_CACHE_TTL=300000
TOKA_TIMEOUT_MS=30000

# Redis Cache (Optional for Production Semantic Caching)
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

# Port for web server
PORT=3000
